# Ignore git and system folders recursively
.git/**
.gitignore
.agents/**
.cursor/**
.codegraph/**
.codex/**
9arm-skills/**

# Ignore local source files
src/**

# Ignore project package files
package.json
package-lock.json
repomix-output.xml
tto
apikey/**
agent/**

# Ignore design docs
PRODUCT.md
DESIGN.md
README.md

# Ignore clasp config files
.clasp.json
.claspignore

# Avoid Apps Script name collision / client JS treated as server scripts
# (rootDir is gas-deploy — match both repo-relative and rootDir-relative names)
gas-deploy/gviz-service.js
gas-deploy/app.js
gas-deploy/config.js
gviz-service.js
app.js
config.js
